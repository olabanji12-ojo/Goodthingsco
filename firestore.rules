rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match products collection
    match /products/{productId} {
      // 1. PUBLIC READ: Allow anyone to read active, unarchived products
      // (Authenticated admins can read all products including archived ones)
      allow read: if resource.data.isArchived == false || isAuthenticated();

      // 2. ADMIN WRITE: Only authenticated administrators can create, update, or archive products
      allow create, update, delete: if isAuthenticated();
    }

    // Default deny for all other collections until explicitly configured
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
