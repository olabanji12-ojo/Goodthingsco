# Good Things Co. — Environment Variables Example Template
# Copy this file to .env and fill in your project credentials

# Unsplash API
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_APPLICATION_ID=your_unsplash_app_id
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary Configuration (Unsigned Upload)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Paystack Configuration (Test Mode)
# PAYSTACK_SECRET_KEY is strictly server-side (never prefix with VITE_)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Transactional email — SERVER ONLY. Never prefix these names with VITE_.
# Leave all four blank until the sender is verified in Resend.
# Incomplete configuration safely skips delivery and logs the event.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# Trusted Firebase server access (never prefix private credentials with VITE_).
# Use service-account JSON via deployment secrets OR GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set true only when Application Default Credentials are configured locally/on the host.
FIREBASE_USE_ADC=false

# Abandoned checkout reminder cron secret — SERVER ONLY, never prefix with VITE_.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to authenticate the POST /api/checkout/reminders/process call from Vercel Cron.
CRON_SECRET=
